set_option language_mode mixed
set_option enableSV09 yes
set_option top apb_trng_wrapper

read_file -type hdl {
  rtl/apb_trng_pkg.sv
  rtl/apb_trng_ro.sv
  rtl/apb_trng_entropy_bank.sv
  rtl/apb_trng_entropy_mixer.sv
  rtl/apb_trng_core.sv
  rtl/apb_trng_apb_if.sv
  rtl/apb_trng_wrapper.sv
}

read_file -type sgdc {cdc/trng.sgdc}
